# Copy to .env (same folder as manage.py) and edit. Never commit .env.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
DJANGO_HTTPS=1
BONDHON_BASE_URL=https://yourname.pythonanywhere.com

# ---- SMS provider (Settings > SMS backend must be "HTTP provider") ----
# Example shape only - take the exact URL / parameter names / success text from YOUR provider's API document.
SMS_HTTP_URL=https://sms-provider.example/api/send
SMS_HTTP_METHOD=POST
SMS_HTTP_PARAMS={"api_key":"{api_key}","senderid":"{sender}","number":"{to}","message":"{message}"}
SMS_HTTP_API_KEY=
SMS_HTTP_SUCCESS_MARKER=
# {to} is sent as 8801XXXXXXXXX. Also available: {username} {password} (SMS_HTTP_USERNAME / SMS_HTTP_PASSWORD).

# ---- Online gateway (Settings > Online gateway = SSLCommerz) ----
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=1
# Fake gateway for demos only - keep 0 in production
PAYMENT_SANDBOX_ENABLED=0
